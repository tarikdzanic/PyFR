fpdtype_t A4535 = M[3][4] * M[5][5] - M[3][5] * M[5][4] ;
fpdtype_t A3535 = M[3][3] * M[5][5] - M[3][5] * M[5][3] ;
fpdtype_t A3435 = M[3][3] * M[5][4] - M[3][4] * M[5][3] ;
